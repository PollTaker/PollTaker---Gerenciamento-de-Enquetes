<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PollTaker — Mission Control</title>
    <style>
        :root {
            --bg-dark: #0a0e17;
            --bg-surface: #111827;
            --border-color: #1f2937;
            --cyan: #06b6d4;
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
        }
        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: system-ui, -apple-system, sans-serif;
            margin: 0;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }
        .sidebar {
            width: 260px;
            background-color: var(--bg-surface);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            padding: 24px;
            justify-content: space-between;
        }
        .brand { font-size: 1.25rem; font-weight: bold; color: #fff; margin-bottom: 30px; }
        .brand span { color: var(--cyan); }
        .nav-links { display: flex; flex-direction: column; gap: 10px; flex-grow: 1; }
        .nav-item {
            padding: 12px 16px;
            color: var(--text-muted);
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
        }
        .nav-item.active, .nav-item:hover { background-color: rgba(6, 182, 212, 0.1); color: var(--cyan); }

        .main-area { flex-grow: 1; display: flex; flex-direction: column; overflow-y: auto; padding: 40px; box-sizing: border-box; }
        .grid-dashboard { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; }
        .card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
        }
        input, select {
            width: 100%;
            padding: 12px;
            background: var(--bg-dark);
            border: 1px solid var(--border-color);
            color: #fff;
            border-radius: 8px;
            margin-top: 6px;
            margin-bottom: 16px;
            box-sizing: border-box;
        }
        label { font-size: 0.85rem; color: var(--text-muted); }
        .btn-primary {
            background-color: var(--cyan);
            color: #000;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
        }
        .poll-card {
            background: var(--bg-dark);
            border: 1px solid var(--border-color);
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 12px;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div>
            <div class="brand">Poll<span>Taker</span></div>
            <nav class="nav-links">
                <a href="#" class="nav-item active">Mission Control</a>
            </nav>
        </div>
        <div>
            <a href="#" id="logoutBtn" class="nav-item" style="color: #ef4444;">Sair</a>
        </div>
    </aside>

    <main class="main-area">
        <div>
            <h1 id="welcomeTitle" style="margin: 0 0 8px 0;">Olá</h1>
            <p style="color: var(--text-muted); margin: 0;">Gerencie suas enquetes e participe das votações ativas.</p>
        </div>

        <div class="grid-dashboard">
            <!-- Coluna 1: Criar Enquete e Adicionar Opção -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <div class="card">
                    <h3 style="margin-top:0;">Criar Nova Enquete</h3>
                    <form id="pollForm">
                        <label>Título<input type="text" id="pollTitle" required></label>
                        <label>Data de Encerramento<input type="datetime-local" id="pollEnd" required></label>
                        <button type="submit" class="btn-primary">Publicar Enquete</button>
                    </form>
                </div>

                <div class="card">
                    <h3 style="margin-top:0;">Adicionar Opção à Enquete</h3>
                    <form id="optionForm">
                        <label>Selecione a Enquete<select id="optionPollSelect" required></select></label>
                        <label>Título da Opção<input type="text" id="optionTitle" required></label>
                        <button type="submit" class="btn-primary">Adicionar Opção</button>
                    </form>
                </div>
            </div>

            <!-- Coluna 2: Enquetes Disponíveis para Votação -->
            <div class="card">
                <h3 style="margin-top:0;">Enquetes Disponíveis</h3>
                <div id="pollsList" style="max-height: 500px; overflow-y: auto;">
                    <p style="color: var(--text-muted);">Carregando enquetes...</p>
                </div>
            </div>
        </div>
    </main>

    <script>
        const API = "http://localhost:8080/api/v1";
        const userId = localStorage.getItem("polltaker_user_id");
        const userName = localStorage.getItem("polltaker_user_name");

        if (!userId) {
            window.location.href = "/";
        } else {
            document.getElementById("welcomeTitle").textContent = `Olá, ${userName} (ID: #${userId})`;
        }

        document.getElementById("logoutBtn").addEventListener("click", () => {
            localStorage.clear();
            window.location.href = "/";
        });

        async function loadData() {
            try {
                const res = await fetch(`${API}/enquetes`);
                const polls = await res.json();

                // Preencher Selects e Lista de Enquetes
                const select = document.getElementById("optionPollSelect");
                const list = document.getElementById("pollsList");

                select.innerHTML = '<option value="" disabled selected>Escolha uma enquete</option>';
                list.innerHTML = "";

                if (polls.length === 0) {
                    list.innerHTML = '<p style="color: var(--text-muted);">Nenhuma enquete cadastrada.</p>';
                    return;
                }

                polls.forEach(p => {
                    select.innerHTML += `<option value="${p.id}">${p.titulo}</option>`;

                    let optionsHtml = (p.opcoes || []).map(o => `
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px; background: var(--bg-surface); padding: 8px; border-radius: 4px;">
                            <span>${o.titulo}</span>
                            <button onclick="vote(${p.id}, ${o.id})" style="background: var(--cyan); border: none; padding: 4px 10px; border-radius: 4px; font-weight: bold; cursor: pointer;">Votar</button>
                        </div>
                    `).join('');

                    list.innerHTML += `
                        <div class="poll-card">
                            <strong>${p.titulo}</strong>
                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 8px;">Status: ${p.status}</div>
                            <div>${optionsHtml || '<span style="font-size:0.8rem; color:var(--text-muted);">Sem opções cadastradas.</span>'}</div>
                        </div>
                    `;
                });
            } catch (err) {
                console.error(err);
            }
        }

        // Criar Enquete
        document.getElementById("pollForm").addEventListener("submit", async (e) => {
            e.preventDefault();
            const titulo = document.getElementById("pollTitle").value;
            const dataEncerramento = document.getElementById("pollEnd").value;

            try {
                const res = await fetch(`${API}/enquetes`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        titulo,
                        criadorId: Number(userId),
                        dataEncerramento: dataEncerramento.length === 16 ? `${dataEncerramento}:00` : dataEncerramento,
                        status: "ABERTA"
                    })
                });
                if(!res.ok) throw new Error("Erro ao criar enquete");
                alert("Enquete criada com sucesso!");
                e.target.reset();
                loadData();
            } catch(err) {
                alert(err.message);
            }
        });

        // Adicionar Opção
        document.getElementById("optionForm").addEventListener("submit", async (e) => {
            e.preventDefault();
            const enqueteId = document.getElementById("optionPollSelect").value;
            const titulo = document.getElementById("optionTitle").value;

            try {
                const res = await fetch(`${API}/opcoes`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ titulo, enqueteId: Number(enqueteId) })
                });
                if(!res.ok) throw new Error("Erro ao adicionar opção");
                alert("Opção adicionada com sucesso!");
                e.target.reset();
                loadData();
            } catch(err) {
                alert(err.message);
            }
        });

        // Registrar Voto
        async function vote(idEnquete, idOpcao) {
            try {
                const res = await fetch(`${API}/votos`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        idUsuario: Number(userId),
                        idEnquete: Number(idEnquete),
                        idOpcao: Number(idOpcao)
                    })
                });
                if(!res.ok) {
                    const errorBody = await res.json();
                    throw new Error(errorBody.detail || "Erro ao registrar voto");
                }
                alert("Voto registrado com sucesso!");
                loadData();
            } catch(err) {
                alert(err.message);
            }
        }

        loadData();
    </script>
</body>
</html>