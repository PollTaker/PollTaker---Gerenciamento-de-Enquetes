<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Resultados</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="container">
        <h1>Histórico</h1>
        <nav><a href="/dashboard">Voltar ao Painel</a></nav>
        <table>
            <thead><tr><th>Título</th><th>Status</th><th>Vencedor</th></tr></thead>
            <tbody>
                <% historico.forEach(function(item) { %>
                <tr><td><%= item.titulo %></td><td><%= item.status %></td><td><%= item.vencedor %></td></tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</body>
</html>