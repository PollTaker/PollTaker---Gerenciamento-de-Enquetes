<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PollTaker - Login</title>
    <!-- Aponta especificamente para o novo CSS do login -->
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="space-theme">
    <div class="login-container">
        <div class="login-card">
            <h1 class="brand-title">Poll<span>Taker</span></h1>
            <p class="subtitle">ACESSO AO MISSION CONTROL</p>

            <form action="/dashboard" method="GET">
                <div class="input-group">
                    <label for="email">EMAIL</label>
                    <div class="input-wrapper">
                        <span class="icon">✉️</span>
                        <input type="email" id="email" placeholder="astronauta@galaxia.com" required>
                    </div>
                </div>

                <div class="input-group">
                    <label for="password">PASSWORD</label>
                    <div class="input-wrapper">
                        <span class="icon">🔒</span>
                        <input type="password" id="password" placeholder="••••••••" required>
                    </div>
                </div>

                <button type="submit" class="btn-cyan">Entrar</button>
            </form>

            <div class="login-links">
                <a href="#">Esqueceu sua senha?</a>
                <p>Não possui conta? <a href="#" class="highlight">Criar Conta</a></p>
            </div>
        </div>
        <footer class="login-footer">
            © 2124 PollTaker Systems. All orbits reserved.
        </footer>
    </div>
</body>
</html>